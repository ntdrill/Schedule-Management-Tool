# ===================================================================
# Schedule-Management-Tool .gitignore
# ===================================================================
# GitHub の Swift テンプレートを参考に、本リポジトリ実体に合わせて整理。
# - Xcode プロジェクト/ワークスペースは XcodeGen が project.yml から
#   生成するためコミット対象外。
# - 半自動開発/tool/ のロックファイル・ローカル観測ログ・スクリーン
#   ショットはローカル専用。

# --- macOS ---------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# --- Xcode ---------------------------------------------------------
# ビルド成果物
build/
DerivedData/

# 個人用 Xcode 状態
xcuserdata/
*.xcuserstate

# XcodeGen 生成物（project.yml が真正典）
*.xcodeproj/
*.xcworkspace/

# --- Swift Package Manager -----------------------------------------
.swiftpm/
Packages/
# Package.resolved は依存バージョンを固定するためコミットする。
# 上のパターンで誤って無視されないよう明示的に否定。
!Package.resolved

# --- Python --------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*$py.class

# --- Node ----------------------------------------------------------
node_modules/

# --- IDE / エディタ ------------------------------------------------
.idea/
.vscode/

# --- ローカルログ --------------------------------------------------
*.log

# --- 半自動開発 (ローカル運用基盤の実行時生成物) -------------------
半自動開発/tool/*.lock
半自動開発/codex_observe/
半自動開発/スクリーンショット/

# --- 認証情報・ローカル設定 ----------------------------------------
.env
.env.*
!.env.example
半自動開発/tool/notify_config.json
